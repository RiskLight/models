{
  "name": "@risklight/models",
  "version": "0.1.0",
  "type": "module",
  "description": "Framework-agnostic Model/Collection with Proxy-based reactivity and Zod validation",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./vue": {
      "import": "./dist/vue/index.js",
      "types": "./dist/vue/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./validation": {
      "import": "./dist/validation/index.js",
      "types": "./dist/validation/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "lint": "oxlint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc"
  },
  "dependencies": {
    "axios": "^1.13.0",
    "lodash-es": "^4.17.21",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "oxlint": "^1.56.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.0",
    "vue": "^3.5.30"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "license": "MIT"
}
