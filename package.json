{
  "name": "@risklight/models",
  "version": "0.2.1",
  "type": "module",
  "description": "Framework-agnostic Model/Collection with Proxy-based reactivity and Zod validation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RiskLight/models.git"
  },
  "homepage": "https://github.com/RiskLight/models",
  "keywords": [
    "model",
    "collection",
    "vue",
    "react",
    "proxy",
    "reactivity",
    "orm",
    "rest",
    "crud",
    "validation",
    "zod",
    "typescript",
    "vue-mc",
    "nuxt"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./vue": {
      "import": "./dist/vue/index.js",
      "types": "./dist/vue/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./validation": {
      "import": "./dist/validation/index.js",
      "types": "./dist/validation/index.d.ts"
    },
    "./nuxt": {
      "import": "./dist/nuxt/index.js",
      "types": "./dist/nuxt/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "lint": "oxlint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc"
  },
  "dependencies": {
    "axios": "^1.13.0",
    "lodash-es": "^4.17.21",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.2.14",
    "oxlint": "^1.56.0",
    "react": "^19.2.4",
    "typescript": "^5.8.0",
    "vitest": "^4.1.0",
    "vue": "^3.5.30"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "license": "MIT"
}
